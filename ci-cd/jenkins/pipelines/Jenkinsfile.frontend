pipeline {
    agent any

    options {
        durabilityHint('PERFORMANCE_OPTIMIZED')
    }

    environment {
        IMAGE_NAME        = 'adelbettaieb/platform-web'
        IMAGE_TAG         = "v${BUILD_NUMBER}"
        NAMESPACE         = 'platform'
        JAVA_TOOL_OPTIONS = '-Djna.tmpdir=/var/jenkins_home/.jna-tmp'
    }

    stages {

        stage('Fix JNA tmp') {
            steps {
                sh 'find /tmp -maxdepth 1 -name "jna-*" -type d -exec rm -rf {} + 2>/dev/null || true'
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-credentials',
                    url: 'https://github.com/Adelbett/platformserverless.git'
            }
        }

        stage('Install & Build') {
            steps {
                dir('web-portal') {
                    sh '''
                        rm -rf node_modules package-lock.json
                        npm install
                        npm run build
                    '''
                }
            }
        }

        stage('Docker Build & Push + Deploy') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        mkdir -p /kaniko/.docker
                        printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}' \
                            $(printf '%s:%s' "$DOCKER_USER" "$DOCKER_PASS" | base64 -w0) \
                            > /kaniko/.docker/config.json

                        DOCKER_CONFIG=/kaniko/.docker /kaniko/executor \
                            --context=dir://$(pwd)/web-portal \
                            --dockerfile=$(pwd)/ci-cd/docker/frontend-kaniko.Dockerfile \
                            --destination=$IMAGE_NAME:$IMAGE_TAG \
                            --destination=$IMAGE_NAME:latest

                        kubectl set image deployment/platform-web \
                            platform-web=$IMAGE_NAME:$IMAGE_TAG \
                            -n platform
                        kubectl rollout status deployment/platform-web -n platform
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                def ws = new File('/var/jenkins_home/workspace')
                if (ws.exists()) {
                    ws.listFiles()?.findAll { it.name.contains('@script') }?.each { it.deleteDir() }
                }
            }
        }
        success {
            echo "✅ Frontend déployé avec succès — ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ Pipeline échoué — vérifier les logs"
        }
    }
}
