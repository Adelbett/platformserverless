pipeline {
    agent any

    options {
        durabilityHint('PERFORMANCE_OPTIMIZED')
        // Retry the whole pipeline once on spawn-helper failures (Kaniko /tmp corruption)
        retry(2)
    }

    tools {
        maven 'maven-3'
        jdk   'jdk-21'
    }

    environment {
        IMAGE_NAME        = 'adelbettaieb/platform-api'
        IMAGE_TAG         = "v${BUILD_NUMBER}"
        NAMESPACE         = 'platform'
        // Force JNA + Maven to never use /tmp — Kaniko wipes /tmp during build
        // which kills Jenkins's spawn helper (fork() fails with exit value: 1)
        JAVA_TOOL_OPTIONS = '-Djna.tmpdir=/var/jenkins_home/.jna-tmp -Djava.io.tmpdir=/var/jenkins_home/.java-tmp'
        TMPDIR            = '/var/jenkins_home/.java-tmp'
    }

    stages {

        stage('Cleanup') {
            steps {
                sh '''
                    # Remove stale @script workspace left by previous failed checkout
                    find /var/jenkins_home/workspace -maxdepth 1 -name "*@script*" -type d \
                        -exec rm -rf {} + 2>/dev/null || true

                    # Remove any JNA dirs that landed in /tmp before Kaniko ran
                    find /tmp -maxdepth 1 -name "jna-*" -type d \
                        -exec rm -rf {} + 2>/dev/null || true

                    # Persistent tmp dirs — these survive Kaniko's /tmp wipe
                    mkdir -p /var/jenkins_home/.jna-tmp
                    mkdir -p /var/jenkins_home/.java-tmp
                '''
            }
        }

        stage('Checkout') {
            steps {
                retry(3) {
                    git branch: 'main',
                        credentialsId: 'github-credentials',
                        url: 'https://github.com/Adelbett/platformserverless.git'
                }
            }
        }

        stage('Build JAR') {
            steps {
                dir('backend-api') {
                    sh '''
                        export JAVA_HOME=/opt/java21
                        export PATH=$JAVA_HOME/bin:$PATH
                        java -version
                        mvn clean package -DskipTests
                    '''
                }
            }
        }

        stage('Docker Build & Push + Deploy') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        mkdir -p /kaniko/.docker

                        # Rebuild persistent tmp dirs in case a previous Kaniko run cleared them
                        mkdir -p /var/jenkins_home/.jna-tmp
                        mkdir -p /var/jenkins_home/.java-tmp

                        printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}' \
                            $(printf '%s:%s' "$DOCKER_USER" "$DOCKER_PASS" | base64 -w0) \
                            > /kaniko/.docker/config.json

                        # TMPDIR points to jenkins_home so Kaniko cannot corrupt JVM tmp
                        TMPDIR=/var/jenkins_home/.java-tmp \
                        DOCKER_CONFIG=/kaniko/.docker /kaniko/executor \
                            --context=dir://$(pwd)/backend-api \
                            --dockerfile=$(pwd)/ci-cd/docker/backend-kaniko.Dockerfile \
                            --destination=${IMAGE_NAME}:${IMAGE_TAG} \
                            --destination=${IMAGE_NAME}:latest

                        kubectl set image deployment/platform-api \
                            platform-api=$IMAGE_NAME:$IMAGE_TAG \
                            -n platform
                        kubectl rollout status deployment/platform-api -n platform
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Backend déployé avec succès — ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ Pipeline échoué — vérifier les logs"
        }
    }
}
