  fv/.style={->, line width=1pt, figVert},
  fc/.style={->, line width=1pt, dashed, figOrange}
]

\node[eta] (s0)  at (0,0)     {\textbf{État de repos : 0 Pod}\\[1pt]\small la Route pointe vers l'Activator};
\node[don] (kou) at (0,-2.6)  {\textbf{Kourier}\\[1pt]\small passerelle d'entrée du cluster};
